{
  "$schema": "https://raw.githubusercontent.com/haffff/NordvikManager-Addons/refs/heads/main/schemas/action.json",
  "name": "Install addon",
  "hook": 1,
  "isEnabled": true,
  "content": [
    {
      "Data": {
        "Label": "Create menus",
        "Value": "roll20compat/create_menus"
      },
      "Type": "ExecuteAction"
    },
    {
      "Data": {
        "Label": "Sheets imported before the generic token existed (templates and their characters)",
        "What": "cards",
        "Property": "roll20compat_content_id",
        "IncludeTemplates": true,
        "Output": "importedSheets"
      },
      "Type": "Find"
    },
    {
      "Data": {
        "Label": "Give each of them the generic token",
        "Collection": "importedSheets",
        "ItemName": "sheet",
        "Do": [
          {
            "Data": {
              "Label": "Use the generic Roll20 token for this sheet",
              "ParentId": "%sheet.id%",
              "PropertyName": "token",
              "PropertyValue": "roll20compat_token_generic.json"
            },
            "Type": "SetProperty"
          }
        ]
      },
      "Type": "ForEach"
    }
  ],
  "gmPermission": 31
}
